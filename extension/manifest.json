{
  "manifest_version": 3,
  "name": "Local Hybrid Email Defender",
  "version": "1.0.0",
  "description": "Analyze an open Gmail message using the locally running Hybrid Email Defender API.",
  "permissions": [],
  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
